# ==============================================================================
# StoreOps Environment Configuration
# Copy this file to .env or .env.local and populate the values.
# ==============================================================================

# Core Application Settings
APP_ENV=development                  # development | staging | production
PROFILE=LOCAL                        # LOCAL (emulators/in-memory) | CLOUD (live GCP)
PORT=8000
MEDIA_STORAGE_DIR=.local_storage/media
STATE_BACKEND=in_memory              # in_memory | firestore

# Gemini AI (Google AI Studio / Vertex AI)
# Required for autonomous reasoning, vision inspection & evals
GEMINI_API_KEY=                      # Get from https://aistudio.google.com/app/apikey
MODEL_ID=gemini-3.8-flash            # Primary model (fallback: gemini-2.5-flash)
AI_MODE=LIVE                         # LIVE (calls Gemini API) | STUB (uses local fixture doubles)

# Firebase Authentication & Firestore
FIREBASE_PROJECT_ID=storeops-dev     # Your GCP/Firebase Project ID
# NEXT_PUBLIC_* variables for Next.js web app (apps/web/)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Cloud Platform & Live Deployment (Wave 2 T11 / Wave 6 T12)
# Required for autonomous live cloud deployment and BigQuery/Storage parity
GOOGLE_APPLICATION_CREDENTIALS=      # Absolute path to service-account.json
GCP_PROJECT_ID=                      # e.g., storeops-production-12345
GCP_REGION=asia-southeast1           # Recommended default region
GCS_MEDIA_BUCKET=                    # Cloud Storage bucket for audit photos/PDFs
BIGQUERY_DATASET=storeops_analytics  # BigQuery dataset for committed sales/stock
CLOUD_TASKS_QUEUE=storeops-jobs      # Cloud Tasks queue name for background worker
