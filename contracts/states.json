{
  "version": "2.0.0",
  "machines": {
    "Job": {
      "initial": "QUEUED",
      "terminal": [
        "SUCCEEDED",
        "FAILED"
      ],
      "transitions": {
        "QUEUED": [
          "RUNNING",
          "FAILED"
        ],
        "RUNNING": [
          "SUCCEEDED",
          "RETRY_WAIT",
          "FAILED"
        ],
        "RETRY_WAIT": [
          "RUNNING",
          "FAILED"
        ],
        "SUCCEEDED": [],
        "FAILED": []
      }
    },
    "Media": {
