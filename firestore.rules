rules_version = '2';

// StoreOps has no client-side Firestore access. Only the API reaches the
// database, through the server SDK with its service account (IAM), which
// security rules do not apply to. Deny all direct client reads and writes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
